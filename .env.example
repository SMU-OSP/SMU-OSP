# Copy to `.env` (git-ignored) and adjust. Used by docker-compose for local
# development / testing. Do NOT use these values for production.

# --- Django ---
SECRET_KEY=dev-insecure-secret-key-change-me
DEBUG=1
# Hosts allowed to serve the backend. "backend" is the compose service name.
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend

# --- Database (MySQL) ---
# DB_HOST/DB_PORT are overridden to the "db" service inside docker-compose;
# the values here are what a host-run backend (outside Docker) would use.
DB_NAME=smu_osp
DB_USER=smu
DB_PASSWORD=smu_password
DB_HOST=127.0.0.1
DB_PORT=3306
# Root password for the MySQL container (compose-only).
MYSQL_ROOT_PASSWORD=root_password

# --- GitHub OAuth / API ---
# Required by settings; may be left blank for basic dev without auth/crawlers.
GH_CLIENT_ID=
GH_CLIENT_SECRET=
GH_PAT=

# --- Celery (overridden to the "redis" service inside docker-compose) ---
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# --- Frontend ---
# URL the browser uses to reach the backend.
VITE_BACKEND_URL=http://127.0.0.1:8000
